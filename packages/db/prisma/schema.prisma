datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  previewFeatures        = ["partialIndexes"]
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  ownedRentalContracts RentalContract[]    @relation("RentalContractOwner")
  recordedPayments     Payment[]           @relation("PaymentRecorder")
  reportedIncidents    Incident[]          @relation("IncidentReporter")
  performedInspections VehicleInspection[] @relation("InspectionInspector")
  activities           Activity[]          @relation("ActivityAuthor")
  mailboxSyncs         MailboxSync[]
  factDecisions        ContactFact[]       @relation("FactDecider")
  conversations        AgentConversation[] @relation("ConversationOwner")
  fieldValues          FieldValue[]        @relation("FieldValueUser")

  createdAgentDefinitions AgentDefinition[]             @relation("AgentDefinitionCreator")
  createdAgentVersions    AgentVersion[]                @relation("AgentVersionCreator")
  createdAgentTriggers    AgentTrigger[]                @relation("AgentTriggerCreator")
  initiatedAgentRuns      AgentRun[]                    @relation("AgentRunInitiator")
  agentAuditEvents        AgentAuditEvent[]             @relation("AgentAuditActor")
  conversationShares      AgentConversationShare[]      @relation("ConversationShareCreator")
  conversationSubmissions AgentConversationSubmission[] @relation("ConversationSubmissionAuthor")
  conversationFeedback    AgentConversationFeedback[]   @relation("ConversationFeedbackAuthor")

  members     Member[]
  invitations Invitation[]

  ssoproviders SsoProvider[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum VehicleType {
  CAR
  MOTORCYCLE
  SCOOTER
  TRUCK
  MINIBUS
}

enum FuelType {
  DIESEL
  GASOLINE
  ELECTRIC
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  OUT_OF_SERVICE
  STOLEN
}

enum RentalContractStatus {
  DRAFT
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RentalChannel {
  AGENT
  ONLINE
}

enum FuelLevel {
  FULL
  THREE_QUARTER
  HALF
  QUARTER
  EMPTY
}

enum DepositMethod {
  CASH
  MOBILE_MONEY
  CARD
  NONE
}

enum DepositStatus {
  HELD
  PARTIALLY_RETURNED
  RETURNED
  FORFEITED
}

enum DriverRole {
  PRIMARY
  ADDITIONAL
}

enum PaymentType {
  RENTAL_FEE
  DEPOSIT
  DEPOSIT_REFUND
  EXTRA_FEE
  PENALTY
  MAINTENANCE_CHARGE
}

enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum IncidentType {
	ACCIDENT
	THEFT
	BREAKDOWN
	DAMAGE
	TRAFFIC_VIOLATION
}

enum IncidentDepositOutcome {
	NONE
	PARTIAL
	FULL
}

enum IncidentDocumentType {
	PHOTO
	POLICE_REPORT
	INVOICE
	OTHER
}

enum ResponsibleParty {
  CLIENT
  AGENCY
  THIRD_PARTY
  UNKNOWN
}

enum InsuranceClaimStatus {
  NOT_FILED
  FILED
  APPROVED
  REJECTED
  PAID
}

enum MaintenanceType {
  SCHEDULED
  REPAIR
}

enum InspectionType {
  CHECK_OUT
  CHECK_IN
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  STAGE_CHANGE
  ENRICHMENT
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  SKIPPED
}

enum RecordSource {
  MANUAL
  IMPORT
  EMAIL
  CALENDAR
}

enum AgentConversationKind {
  RECORD
  BUILDER
}

enum AgentDefinitionStatus {
  DRAFT
  DEPLOYING
  LIVE
  PAUSED
  ARCHIVED
  DELETED
}

enum AgentVersionStatus {
  DRAFT
  VALIDATING
  READY
  DEPLOYED
  REJECTED
}

enum AgentBuilderArtifactStatus {
  WRITING
  READY
}

enum AgentTriggerType {
  MANUAL
  SCHEDULE
  EVENT
  WEBHOOK
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentActionStatus {
  PLANNED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentConversationShareScope {
  WORKSPACE_LINK
}

enum AgentConversationSubmissionStatus {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  CANCELLED
}

enum AgentConversationCommandType {
  CHAT
  CREATE_AGENT
}

enum AgentResponseRating {
  UP
  DOWN
}

enum ContactGender {
  H
  F
}

model Contact {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String?
  gender      ContactGender @default(H)
  email       String? @unique
  phone       String?
  title       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  imageUrl    String?

  socialsCheckedAt DateTime?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?

  brief         ContactBrief?
  facts         ContactFact[]
  conversations AgentConversation[]

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?

  rentalContracts RentalContract[]
  driverOn        RentalContractDriver[]
  activities      Activity[]
  emailThreads    EmailThread[]
  calendarEvents  CalendarEvent[]
  eventAttendance CalendarAttendee[]
  fieldValues     FieldValue[]
  documents       ContactDocument[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([lastActivityAt])
  @@map("contact")
}

enum ContactDocumentType {
  DRIVERS_LICENSE
  ID_CARD
  PROOF_OF_ADDRESS
  OTHER
}

model ContactDocument {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  type        ContactDocumentType
  url         String
  fileName    String?
  contentType String?

  createdAt DateTime @default(now())

  @@index([contactId])
  @@map("contactDocument")
}

enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED
}

model ContactFact {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  field String
  value String

  score Float
  band  FactBand

  evidence Json

  method    String
  sourceUrl String?

  sessionId String?

  status      FactStatus @default(PROPOSED)
  decidedById String?
  decidedBy   User?      @relation("FactDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  observedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@index([contactId, field, status])
  @@index([status, observedAt])
  @@map("contactFact")
}

model ContactBrief {
  contactId String  @id
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  narrative String
  sections  Json

  score     Float
  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("contactBrief")
}

model AgentTask {
  id        String  @id @default(cuid())
  contactId String?

  kind   String
  reason String

  priority Int @default(0)
  budget   Int @default(4)
  attempts Int @default(0)

  dueAt       DateTime
  leasedUntil DateTime?

  sessionId  String?
  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  createdAt DateTime @default(now())

  @@index([dueAt, leasedUntil])
  @@index([contactId])
  @@map("agentTask")
}

model AgentEvent {
  id        String  @id
  sessionId String
  contactId String?
  type      String
  data      Json

  emittedAt DateTime

  @@index([sessionId, emittedAt])
  @@index([contactId, emittedAt])
  @@map("agentEvent")
}

model AgentConversation {
  id String @id @default(cuid())

  kind AgentConversationKind @default(RECORD)

  contactId        String?
  contact          Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rentalContractId String?
  rentalContract   RentalContract? @relation(fields: [rentalContractId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  agentId String?
  agent   AgentDefinition? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  sessionId         String? @unique
  continuationToken String?
  streamIndex       Int     @default(0)

  title        String?
  messageCount Int     @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastMessageAt   DateTime  @default(now())
  lastAssistantAt DateTime?
  lastReadAt      DateTime?

  shares           AgentConversationShare[]
  submissions      AgentConversationSubmission[]
  feedback         AgentConversationFeedback[]
  createdVersions  AgentVersion[]                @relation("AgentVersionSourceConversation")
  builderArtifacts AgentBuilderArtifact[]

  @@index([contactId, lastMessageAt])
  @@index([vehicleId, lastMessageAt])
  @@index([rentalContractId, lastMessageAt])
  @@index([userId, kind, lastMessageAt])
  @@index([agentId, lastMessageAt])
  @@map("agentConversation")
}

model AgentConversationFeedback {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)

  messageId String
  rating    AgentResponseRating

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId, messageId])
  @@index([conversationId, createdAt])
  @@map("agentConversationFeedback")
}

model AgentConversationShare {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ConversationShareCreator", fields: [createdById], references: [id], onDelete: Cascade)

  scope     AgentConversationShareScope @default(WORKSPACE_LINK)
  tokenHash String                      @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@unique([conversationId], map: "agentConversationShare_one_active_per_conversation", where: { revokedAt: null })
  @@index([conversationId, revokedAt])
  @@map("agentConversationShare")
}

model AgentConversationSubmission {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("ConversationSubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)

  clientRequestId String                            @unique
  inputRequestId  String?
  commandType     AgentConversationCommandType      @default(CHAT)
  message         Json
  status          AgentConversationSubmissionStatus @default(PENDING)
  attemptCount    Int                               @default(0)

  errorCode    String?
  errorMessage String?

  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  acceptedAt DateTime?

  attachments AgentConversationAttachment[]

  @@unique([conversationId, inputRequestId])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@map("agentConversationSubmission")
}

model AgentConversationAttachment {
  id String @id @default(cuid())

  submissionId String
  submission   AgentConversationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  name      String
  mediaType String
  size      Int
  content   Bytes
  position  Int

  createdAt DateTime @default(now())

  @@index([submissionId, position])
  @@map("agentConversationAttachment")
}

model AgentDefinition {
  id String @id @default(cuid())

  name        String
  description String?
  status      AgentDefinitionStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("AgentDefinitionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  currentVersionId String?       @unique
  currentVersion   AgentVersion? @relation("CurrentAgentVersion", fields: [currentVersionId, id], references: [id, agentId], onDelete: Restrict)

  versions      AgentVersion[]      @relation("AgentVersions")
  triggers      AgentTrigger[]
  runs          AgentRun[]
  actions       AgentAction[]
  auditEvents   AgentAuditEvent[]
  conversations AgentConversation[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  @@unique([currentVersionId, id])
  @@index([status, updatedAt])
  @@index([createdById, createdAt])
  @@map("agentDefinition")
}

model AgentVersion {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Restrict)

  number Int
  status AgentVersionStatus @default(DRAFT)

  instructions             String
  manifest                 Json
  modelId                  String
  modelContextWindowTokens Int    @default(1000000)
  sandboxPolicy            Json
  validation               Json?

  sourceConversationId String?
  sourceConversation   AgentConversation? @relation("AgentVersionSourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("AgentVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  deploymentId String?
  approvedAt   DateTime?
  deployedAt   DateTime?
  createdAt    DateTime  @default(now())

  currentFor       AgentDefinition?       @relation("CurrentAgentVersion")
  triggers         AgentTrigger[]
  runs             AgentRun[]
  auditEvents      AgentAuditEvent[]
  builderArtifacts AgentBuilderArtifact[]

  @@unique([agentId, number])
  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([status, createdAt])
  @@map("agentVersion")
}

model AgentBuilderArtifact {
  id String @id @default(cuid())

  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  versionId String?
  version   AgentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  path            String
  language        String
  content         String
  previousContent String?
  revision        Int
  status          AgentBuilderArtifactStatus @default(WRITING)
  createdAt       DateTime                   @default(now())

  @@unique([conversationId, path, revision], map: "agentBuilderArtifact_conversation_path_revision_key", where: { conversationId: { not: null } })
  @@unique([versionId, path, revision], map: "agentBuilderArtifact_version_path_revision_key", where: { versionId: { not: null } })
  @@index([conversationId, createdAt])
  @@index([versionId, path])
  @@map("agentBuilderArtifact")
}

model AgentTrigger {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String
  version   AgentVersion @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  type   AgentTriggerType
  name   String
  config Json

  createdById String
  createdBy   User   @relation("AgentTriggerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  enabled   Boolean   @default(false)
  nextRunAt DateTime?
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  runs AgentRun[]

  @@unique([id, agentId])
  @@index([agentId, enabled])
  @@index([enabled, nextRunAt])
  @@index([versionId])
  @@map("agentTrigger")
}

model AgentRun {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String
  version   AgentVersion @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  triggerId String?
  trigger   AgentTrigger? @relation(fields: [triggerId, agentId], references: [id, agentId], onDelete: Restrict)

  initiatedById String?
  initiatedBy   User?   @relation("AgentRunInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  triggerType    AgentTriggerType
  status         AgentRunStatus   @default(QUEUED)
  principalId    String?
  sessionId      String?          @unique
  idempotencyKey String           @unique
  correlationId  String           @unique

  input   Json?
  result  Json?
  summary String?

  modelId      String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)

  errorCode    String?
  errorMessage String?

  nextEventSequence Int @default(0)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  events  AgentRunEvent[]
  actions AgentAction[]

  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([versionId, createdAt])
  @@index([status, createdAt])
  @@index([triggerId, createdAt])
  @@map("agentRun")
}

model AgentRunEvent {
  id String @id @default(cuid())

  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  sequence  Int
  type      String
  data      Json
  emittedAt DateTime @default(now())

  @@unique([runId, sequence])
  @@index([runId, emittedAt])
  @@map("agentRunEvent")
}

model AgentAction {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  runId String
  run   AgentRun @relation(fields: [runId, agentId], references: [id, agentId], onDelete: Restrict)

  type        String
  provider    String
  targetType  String?
  targetId    String?
  targetLabel String?
  summary     String
  metadata    Json?

  status         AgentActionStatus @default(PLANNED)
  idempotencyKey String            @unique
  requestHash    String?
  externalId     String?
  attemptCount   Int               @default(0)

  errorCode    String?
  errorMessage String?

  plannedAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([agentId, plannedAt])
  @@index([runId, plannedAt])
  @@index([provider, externalId])
  @@index([status, plannedAt])
  @@map("agentAction")
}

model AgentAuditEvent {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String?
  version   AgentVersion? @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  actorUserId String?
  actorUser   User?   @relation("AgentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  type      String
  actorType String
  actorId   String?
  summary   String
  before    Json?
  after     Json?
  requestId String?
  emittedAt DateTime @default(now())

  @@unique([agentId, type, requestId])
  @@index([agentId, emittedAt])
  @@index([versionId, emittedAt])
  @@index([actorUserId, emittedAt])
  @@index([type, emittedAt])
  @@map("agentAuditEvent")
}

model Vehicle {
  id          String        @id @default(cuid())
  type        VehicleType
  fuelType    FuelType      @default(GASOLINE)
  make        String
  model       String
  year        Int?
  plateNumber String        @unique
  vin         String?
  color       String?
  status      VehicleStatus @default(AVAILABLE)

  dailyRate Decimal? @db.Decimal(14, 2)
  currency  String   @default("USD")

  baseAmount   Decimal?  @db.Decimal(24, 4)
  baseCurrency String?
  fxRate       Decimal?  @db.Decimal(20, 10)
  fxRateAt     DateTime?

  mileage Int @default(0)

  insurancePolicyNumber String?
  insuranceExpiresAt    DateTime?
  registrationExpiresAt DateTime?

  nextMaintenanceAtKm   Int?
  nextMaintenanceAtDate DateTime?

  photoUrls String[] @default([])

  lastActivityAt DateTime?

  conversations      AgentConversation[]
  rentalContracts    RentalContract[]
  mileageHistory     VehicleMileageEntry[]
  incidents          Incident[]
  maintenanceRecords MaintenanceRecord[]
  financing          VehicleFinancing?
  charges            VehicleCharge[]
  activities         Activity[]
  fieldValues        FieldValue[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([type])
  @@index([lastActivityAt])
  @@index([baseAmount])
  @@index([currency])
  @@index([nextMaintenanceAtDate])
  @@index([insuranceExpiresAt])
  @@map("vehicle")
}

enum FinancingType {
  LOAN
  LEASING
}

enum ChargeFrequency {
  ONE_TIME
  MONTHLY
}

model VehicleFinancing {
  vehicleId String  @id
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type FinancingType

  principalAmount Decimal? @db.Decimal(14, 2)
  monthlyPayment  Decimal  @db.Decimal(14, 2)
  currency        String   @default("USD")

  baseAmount   Decimal?  @db.Decimal(24, 4)
  baseCurrency String?
  fxRate       Decimal?  @db.Decimal(20, 10)
  fxRateAt     DateTime?

  interestRate Decimal? @db.Decimal(6, 3)
  termMonths   Int?
  startDate    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicleFinancing")
}

model VehicleCharge {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  label  String
  amount Decimal @db.Decimal(14, 2)

  currency String @default("USD")

  baseAmount   Decimal?  @db.Decimal(24, 4)
  baseCurrency String?
  fxRate       Decimal?  @db.Decimal(20, 10)
  fxRateAt     DateTime?

  frequency ChargeFrequency
  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@map("vehicleCharge")
}

model RentalContract {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  ownerId   String
  owner     User    @relation("RentalContractOwner", fields: [ownerId], references: [id])

  status  RentalContractStatus @default(DRAFT)
  channel RentalChannel        @default(AGENT)

  startDate      DateTime
  endDate        DateTime
  pickupTime     String?
  returnTime     String?
  actualPickupAt DateTime?
  actualReturnAt DateTime?

  pricePerDay Decimal @db.Decimal(14, 2)
  currency    String  @default("USD")
  totalAmount Decimal @db.Decimal(14, 2)

  baseAmount   Decimal?  @db.Decimal(24, 4)
  baseCurrency String?
  fxRate       Decimal?  @db.Decimal(20, 10)
  fxRateAt     DateTime?

  mileageIncludedPerDay Int?
  extraMileageFeePerKm  Decimal?   @db.Decimal(10, 2)
  extraMileageAmount    Decimal?   @db.Decimal(14, 2)
  mileageAtPickup       Int?
  mileageAtReturn       Int?
  fuelLevelAtPickup     FuelLevel?
  fuelLevelAtReturn     FuelLevel?

  depositAmount         Decimal       @db.Decimal(14, 2)
  depositCurrency       String        @default("USD")
  depositMethod         DepositMethod @default(NONE)
  depositStatus         DepositStatus @default(HELD)
  depositReturnedAmount Decimal?      @db.Decimal(14, 2)
  depositReturnedAt     DateTime?

  cancelledAt         DateTime?
  cancelledReason     String?
  contractDocumentUrl String?
  signedAt            DateTime?
  notes               String?

  lastActivityAt DateTime?

  conversations AgentConversation[]
  drivers       RentalContractDriver[]
  payments      Payment[]
  incidents     Incident[]
  inspections   VehicleInspection[]
  activities    Activity[]
  fieldValues   FieldValue[]
  mileageRules  RentalContractMileageRule[]
  mileageEntry  VehicleMileageEntry?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([vehicleId])
  @@index([contactId])
  @@index([ownerId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([lastActivityAt])
  @@index([baseAmount])
  @@index([currency])
  @@index([channel])
  @@map("rentalContract")
}

model VehicleMileageEntry {
  id         String         @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  contractId String?        @unique
  contract   RentalContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  mileage    Int
  recordedAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@index([vehicleId, recordedAt])
  @@map("vehicleMileageEntry")
}

model RentalContractMileageRule {
  id         String        @id @default(cuid())
  contractId String
  contract   RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kilometers Int?
  pricePerKm Decimal       @db.Decimal(10, 2)
  position   Int
  createdAt  DateTime      @default(now())

  @@index([contractId, position])
  @@map("rentalContractMileageRule")
}

model RentalContractDriver {
  contractId String
  contract   RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role       DriverRole     @default(ADDITIONAL)

  @@id([contractId, contactId])
  @@index([contactId])
  @@map("rentalContractDriver")
}

model Payment {
  id               String         @id @default(cuid())
  rentalContractId String
  rentalContract   RentalContract @relation(fields: [rentalContractId], references: [id], onDelete: Cascade)

  type     PaymentType
  amount   Decimal     @db.Decimal(14, 2)
  currency String      @default("USD")

  baseAmount   Decimal?  @db.Decimal(24, 4)
  baseCurrency String?
  fxRate       Decimal?  @db.Decimal(20, 10)
  fxRateAt     DateTime?

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  reference String?
  paidAt    DateTime?
  notes     String?

  recordedById String
  recordedBy   User   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rentalContractId])
  @@index([type])
  @@index([status])
  @@index([paidAt])
  @@map("payment")
}

model Incident {
  id               String          @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rentalContractId String?
  rentalContract   RentalContract? @relation(fields: [rentalContractId], references: [id], onDelete: SetNull)

  type         IncidentType
  reportedAt   DateTime     @default(now())
  reportedById String
  reportedBy   User         @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  description  String
  damageAreas  String[]     @default([])
  damageAnnotations IncidentDamageAnnotation[]

  responsibleParty ResponsibleParty @default(UNKNOWN)

	insuranceClaimNumber String?
	insuranceStatus      InsuranceClaimStatus @default(NOT_FILED)
	depositOutcome       IncidentDepositOutcome @default(NONE)
	depositDeductedAmount Decimal?             @db.Decimal(14, 2)
	depositCurrency       String?

	estimatedCost Decimal? @db.Decimal(14, 2)
  actualCost    Decimal? @db.Decimal(14, 2)
  currency      String?

  policeReportReference String?
	photoUrls             String[]  @default([])
	documents             IncidentDocument[]
	resolvedAt            DateTime?
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([rentalContractId])
  @@index([type])
  @@index([insuranceStatus])
  @@index([reportedAt])
	@@map("incident")
}

enum IncidentDamageView {
	THREE_QUARTER
	FRONT
	REAR
	LEFT_SIDE
	RIGHT_SIDE
	ROOF
	INTERIOR
}

enum IncidentDamageType {
	SCRATCH
	DENT
	CRACK
	BROKEN
	MISSING
	STAIN
	OTHER
}

enum IncidentDamageSeverity {
	MINOR
	MODERATE
	SEVERE
}

model IncidentDamageAnnotation {
	id         String       @id @default(cuid())
	incidentId String
	incident   Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
	view       IncidentDamageView
	type       IncidentDamageType
	severity   IncidentDamageSeverity
	x          Float
	y          Float
	points     Json?
	description String?
	createdAt  DateTime     @default(now())
	updatedAt  DateTime     @updatedAt

	@@index([incidentId])
	@@map("incidentDamageAnnotation")
}

model IncidentDocument {
	id         String       @id @default(cuid())
	incidentId String
	incident   Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
	type       IncidentDocumentType
	url        String
	fileName   String?
	contentType String?
	amount     Decimal?     @db.Decimal(14, 2)
	currency   String?
	insuranceReimbursedAmount Decimal? @db.Decimal(14, 2)
	createdAt  DateTime     @default(now())

	@@index([incidentId])
	@@map("incidentDocument")
}

model MaintenanceRecord {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type        MaintenanceType
  description String

  scheduledAtKm     Int?
  scheduledAtDate   DateTime?
  completedAt       DateTime?
  odometerAtService Int?
  mechanic          String?

  cost             Decimal? @db.Decimal(14, 2)
  currency         String?
  invoiceReference String?

  blocksAvailability Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([scheduledAtDate])
  @@index([completedAt])
  @@map("maintenanceRecord")
}

model VehicleInspection {
  id               String         @id @default(cuid())
  rentalContractId String
  rentalContract   RentalContract @relation(fields: [rentalContractId], references: [id], onDelete: Cascade)

  type        InspectionType
  odometer    Int
  fuelLevel   FuelLevel
  damageNotes String?
  photoUrls   String[]       @default([])

  inspectedById String
  inspectedBy   User     @relation("InspectionInspector", fields: [inspectedById], references: [id], onDelete: Restrict)
  inspectedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rentalContractId])
  @@index([type])
  @@map("vehicleInspection")
}

enum RateSource {
  FETCHED
  MANUAL
}

model ExchangeRate {
  id            String     @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal    @db.Decimal(20, 10)
  asOf          DateTime
  source        RateSource
  provider      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([baseCurrency, quoteCurrency, source])
  @@index([baseCurrency, quoteCurrency])
  @@map("exchangeRate")
}

enum FieldEntity {
  CONTACT
  VEHICLE
  RENTAL_CONTRACT
}

enum FieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  CHECKBOX
  SELECT
  URL
  EMAIL
  PHONE
  USER
}

model FieldDefinition {
  id     String      @id @default(cuid())
  entity FieldEntity
  key    String
  label  String
  type   FieldType

  agentFilled Boolean @default(true)
  agentBrief  String?

  required    Boolean @default(false)
  showOnSheet Boolean @default(true)
  showOnTable Boolean @default(false)
  position    Int

  archivedAt DateTime?

  options FieldOption[]
  values  FieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, key])
  @@index([entity, position])
  @@map("fieldDefinition")
}

model FieldOption {
  id       String          @id @default(cuid())
  fieldId  String
  field    FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label    String
  position Int

  archivedAt DateTime?
  values     FieldValue[]

  @@index([fieldId, position])
  @@map("fieldOption")
}

model FieldValue {
  id      String          @id @default(cuid())
  fieldId String
  field   FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  contactId        String?
  contact          Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rentalContractId String?
  rentalContract   RentalContract? @relation(fields: [rentalContractId], references: [id], onDelete: Cascade)

  text     String?
  number   Decimal?     @db.Decimal(24, 4)
  date     DateTime?
  bool     Boolean?
  optionId String?
  option   FieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  userId   String?
  user     User?        @relation("FieldValueUser", fields: [userId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([fieldId, contactId])
  @@unique([fieldId, vehicleId])
  @@unique([fieldId, rentalContractId])
  @@index([fieldId, text])
  @@index([fieldId, number])
  @@index([fieldId, date])
  @@index([contactId])
  @@index([vehicleId])
  @@index([rentalContractId])
  @@index([optionId])
  @@index([userId])
  @@map("fieldValue")
}

model Activity {
  id      String       @id @default(cuid())
  type    ActivityType
  subject String?
  body    String?

  occurredAt  DateTime?
  dueAt       DateTime?
  completedAt DateTime?

  contactId        String?
  contact          Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rentalContractId String?
  rentalContract   RentalContract? @relation(fields: [rentalContractId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ActivityAuthor", fields: [createdById], references: [id])
  meta        Json?

  emailThreadId   String?        @unique
  emailThread     EmailThread?   @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  calendarEventId String?        @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, createdAt])
  @@index([rentalContractId, createdAt])
  @@index([contactId, createdAt])
  @@index([dueAt])
  @@index([createdById])
  @@map("activity")
}

enum GoogleSyncStatus {
  IDLE
  RUNNING
  NEEDS_RECONNECT
  FAILED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model MailboxSync {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source String

  status       GoogleSyncStatus @default(IDLE)
  cursor       String?
  lastSyncedAt DateTime?
  lastError    String?
  retryAfter   DateTime?
  autoCreate   Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source])
  @@index([status])
  @@map("mailboxSync")
}

model EmailThread {
  id            String  @id @default(cuid())
  rootMessageId String  @unique
  subject       String?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  firstMessageAt DateTime
  lastMessageAt  DateTime
  messageCount   Int      @default(0)

  messages EmailMessage[]
  activity Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId, lastMessageAt])
  @@map("emailThread")
}

model EmailMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  rfcMessageId     String  @unique
  syncedByUserId   String?
  gmailMessageId   String?
  outlookMessageId String?
  outlookWebLink   String?

  direction  EmailDirection
  fromEmail  String
  fromName   String?
  recipients Json
  subject    String?
  snippet    String?
  body       String?
  sentAt     DateTime

  createdAt DateTime @default(now())

  @@index([threadId, sentAt])
  @@map("emailMessage")
}

model CalendarEvent {
  id                String   @id @default(cuid())
  iCalUid           String
  originalStartTime DateTime
  recurringEventId  String?

  title          String?
  description    String?
  location       String?
  conferenceUrl  String?
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean  @default(false)
  status         String
  organizerEmail String?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  syncedByUserId String?
  googleEventId  String?

  attendees CalendarAttendee[]
  activity  Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([iCalUid, originalStartTime])
  @@index([contactId, startsAt])
  @@map("calendarEvent")
}

model CalendarAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  email          String
  name           String?
  responseStatus String?
  isOrganizer    Boolean  @default(false)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([contactId])
  @@map("calendarAttendee")
}

model SuppressedDomain {
  domain    String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("suppressedDomain")
}

model SuppressedContact {
  email     String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("suppressedContact")
}

model AppSetting {
  id String @id

  agentModelId String?

  agentModelContextWindow Int?

  contextDevApiKey String?

  reportingCurrency String?

  ratesRefreshedAt DateTime?

  updatedAt DateTime @updatedAt

  @@map("appSetting")
}

model Install {
  id String @id

  uuid    String @unique
  version String

  lastRollupAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("install")
}

model TelemetryMilestone {
  step      String   @id
  reachedAt DateTime @default(now())

  @@map("telemetryMilestone")
}

model TelemetryCounter {
  name      String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("telemetryCounter")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  website     String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model WorkspaceProfile {
  id String @id

  website   String
  narrative String
  sections  Json

  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("workspaceProfile")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model SsoProvider {
  id             String  @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  organizationId String?
  domain         String

  @@unique([providerId])
  @@map("ssoProvider")
}
