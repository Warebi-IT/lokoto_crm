{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"inputs": ["$TURBO_DEFAULT$", "prisma/**"],
			"outputs": ["src/generated/**"],
			"passThroughEnv": ["BDD_URL"]
		},
		"dev:prepare": {
			"cache": false,
			"inputs": [
				"prisma/schema.prisma",
				"prisma/migrations/**",
				"prisma.config.ts",
				"scripts/prepare-dev.ts",
				"scripts/require-local-db.ts"
			],
			"outputs": ["src/generated/**"],
			"passThroughEnv": ["ALLOW_REMOTE_DB", "BDD_URL"]
		},
		"db:generate": {
			"inputs": ["$TURBO_DEFAULT$", "prisma/**"],
			"outputs": ["src/generated/**"],
			"passThroughEnv": ["BDD_URL"]
		},
		"db:deploy": {
			"cache": false,
			"passThroughEnv": ["BDD_URL"]
		},
		"db:migrate": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["BDD_URL"]
		},
		"db:push": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["BDD_URL"]
		},
		"db:reset": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["BDD_URL"]
		},
		"db:seed": {
			"cache": false,
			"passThroughEnv": ["BLOB_READ_WRITE_TOKEN", "BDD_URL"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["BDD_URL"]
		},
		"check-types": {
			"dependsOn": ["$TURBO_EXTENDS$", "build"],
			"passThroughEnv": ["BDD_URL"]
		}
	}
}
